{
   "name": "task-manager-app",
   "private": true,
   "version": "1.0.0",
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "npm run typecheck && vite build",
      "lint": "eslint . --ext ts,tsx",
      "lint:css": "stylelint '**/*.scss'",
      "typecheck": "tsc --noEmit -p tsconfig.app.json",
      "format": "prettier --write .",
      "preview": "vite preview",
      "storybook": "storybook dev -p 6006",
      "build-storybook": "storybook build",
      "test": "vitest run",
      "test:unit": "vitest run --project unit",
      "test:storybook": "vitest run --project storybook"
   },
   "dependencies": {
      "@radix-ui/react-dialog": "^1.3.1",
      "@radix-ui/react-dropdown-menu": "^2.2.1",
      "@radix-ui/react-icons": "^1.3.2",
      "@radix-ui/react-progress": "^1.2.1",
      "@tanstack/react-query": "^5.105.0",
      "axios": "^1.21.0",
      "clsx": "^2.1.1",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-router-dom": "^7.18.5",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@chromatic-com/storybook": "latest",
      "@eslint-react/eslint-plugin": "^5.28.8",
      "@eslint/js": "^9.15.0",
      "@storybook/addon-a11y": "^10.6.5",
      "@storybook/addon-docs": "^10.6.5",
      "@storybook/addon-vitest": "^10.6.5",
      "@storybook/react-vite": "^10.6.5",
      "@tanstack/eslint-plugin-query": "^5.105.0",
      "@types/node": "^24.19.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/react-router-dom": "^5.3.3",
      "@vitejs/plugin-react": "^6.1.2",
      "@vitest/browser": "^5.0.5",
      "@vitest/browser-playwright": "latest",
      "@vitest/coverage-v8": "latest",
      "eslint": "^9.15.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.7",
      "eslint-plugin-simple-import-sort": "^14.0.0",
      "eslint-plugin-storybook": "^10.6.5",
      "globals": "^17.13.0",
      "msw": "^3.0.3",
      "playwright": "latest",
      "prettier": "^3.9.10",
      "sass-embedded": "^1.106.1",
      "storybook": "^10.6.5",
      "stylelint": "^17.16.0",
      "stylelint-config-standard-scss": "^17.0.0",
      "stylelint-order": "^8.1.2",
      "typescript": "^5.5.4",
      "typescript-eslint": "^8.72.0",
      "vite": "^8.3.5",
      "vitest": "latest"
   },
   "msw": {
      "workerDirectory": [
         "public"
      ]
   }
}